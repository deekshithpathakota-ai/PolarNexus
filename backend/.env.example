# ---- Database -------------------------------------------------------------
# PostgreSQL with pgvector (Supabase / Neon / Render / Railway all provide it).
# postgres:// and postgresql:// URLs are both accepted.
# Leave unset to use a local SQLite file (vector search then runs in-process).
DATABASE_URL=postgresql://polar:polar@localhost:5432/polarnexus

# ---- Auth -----------------------------------------------------------------
# REQUIRED in production: a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Demo mode: one-click demo accounts + auto-seed of an empty database + admin "reset demo" button.
DEMO_MODE=true
# Password for the seeded demo accounts (used only when seeding).
DEMO_USER_PASSWORD=polarnexus-demo

# ---- CORS -----------------------------------------------------------------
# Comma-separated frontend origins. *.vercel.app preview URLs are also allowed by default.
CORS_ORIGINS=http://localhost:3000

# ---- AI provider (optional) ----------------------------------------------
# Any OpenAI-compatible endpoint. Without a key the app uses offline LSA embeddings,
# extractive answers and clearly-labelled curated demo responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=30

# ---- Storage --------------------------------------------------------------
# Uploaded files are stored on local disk at STORAGE_DIR. The S3/Supabase settings are
# reserved for an object-storage backend (not wired in this prototype).
STORAGE_DIR=./storage
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
MAX_UPLOAD_MB=25

ENVIRONMENT=development
