# ---- Database -------------------------------------------------------------
# PostgreSQL with pgvector (Supabase / Neon / Render / Railway all provide it).
# postgres:// and postgresql:// URLs are both accepted.
# Leave unset to use a local SQLite file (vector search then runs in-process).
DATABASE_URL=postgresql://polar:polar@localhost:5432/polarnexus

# ---- Auth -----------------------------------------------------------------
# REQUIRED in production: a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# Demo mode: one-click demo accounts + auto-seed of an empty database + admin "reset demo" button.
DEMO_MODE=true
# Password for the seeded demo accounts (used only when seeding).
DEMO_USER_PASSWORD=polarnexus-demo

# ---- CORS -----------------------------------------------------------------
# Comma-separated frontend origins. *.vercel.app preview URLs are also allowed by default.
CORS_ORIGINS=http://localhost:3000

# ---- AI provider (optional) ----------------------------------------------
# Any OpenAI-compatible endpoint (OpenAI, Azure proxies, Groq, Together, vLLM, Ollama's /v1 …).
# Without a key the app uses offline LSA embeddings, extractive answers and clearly-labelled curated demo responses.
# v3 provider-neutral names (take precedence). Leave empty to use the OPENAI_* values below.
LLM_PROVIDER=            # openai | openai-compatible | none (none = force the offline fallback)
LLM_API_KEY=
LLM_BASE_URL=            # e.g. https://api.groq.com/openai/v1 or http://localhost:11434/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=      # openai | openai-compatible | local (local = offline TF-IDF + LSA)
EMBEDDING_API_KEY=       # defaults to LLM_API_KEY / OPENAI_API_KEY
EMBEDDING_BASE_URL=      # defaults to LLM_BASE_URL / OPENAI_BASE_URL
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=30
# Original names (still supported)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Visual semantic search (optional) -------------------------------------
# auto = enabled when `fastembed` is installed (pip install -r requirements-visual.txt); clip = required; none = off
VISUAL_SEARCH_PROVIDER=auto
VISUAL_IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
VISUAL_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
VISUAL_MODEL_CACHE=./.model_cache
VISUAL_MIN_SIMILARITY=0.265
VIDEO_MAX_KEYFRAMES=24

# ---- OCR for scanned PDFs (tesseract CLI; installed by the Dockerfile) ----
OCR_ENABLED=true
OCR_LANGUAGES=eng
OCR_MIN_CHARS_PER_PAGE=40
OCR_MAX_PAGES=60

# ---- Dataset ingestion (CSV / TSV / JSON / GeoJSON) ------------------------
MAX_DATASET_MB=25
MAX_DATASET_ROWS=100000

# ---- Storage --------------------------------------------------------------
# local (default): files under STORAGE_DIR.  s3: any S3-compatible store (AWS S3, R2, MinIO, Supabase S3 API);
# a working copy is kept under STORAGE_DIR for processing. Requires: pip install -r requirements-s3.txt
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=polarnexus/
# Legacy placeholders from v2 (unused)
STORAGE_URL=
STORAGE_KEY=
STORAGE_SECRET=
MAX_UPLOAD_MB=25
# Media ingestion (images via Pillow; video metadata/thumbnails/audio via ffmpeg when installed)
MAX_IMAGE_MB=20
MAX_VIDEO_MB=200
# Speech-to-text for uploaded videos (OpenAI-compatible /audio/transcriptions; needs OPENAI_API_KEY)
STT_MODEL=whisper-1
STT_ENABLED=true

# ---- Security -------------------------------------------------------------
# Allow *.vercel.app preview origins (convenient for demos; set false in production)
CORS_ALLOW_VERCEL_PREVIEWS=true
# Failed sign-ins allowed per client IP + email within the window before HTTP 429
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=300

# Per-client-IP limits for expensive endpoints (requests per minute; 0 disables)
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_MINUTE=20
# HttpOnly session cookie issued at sign-in in addition to the bearer token (Secure flag in production).
# Cookie-only state-changing requests must send the X-PolarNexus-Client header (CSRF guard).
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_NAME=pn_session

# production refuses to start with the default JWT_SECRET
ENVIRONMENT=development
